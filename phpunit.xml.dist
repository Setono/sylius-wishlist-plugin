<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd" colors="true"
         bootstrap="tests/Application/config/bootstrap.php" cacheDirectory=".phpunit.cache"
         defaultTestSuite="unit,functional">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="functional">
            <directory>tests/Functional</directory>
        </testsuite>
        <!-- Real-browser tests (playwright-php/playwright-symfony). Not in the default run: they need Node and the
             Playwright browsers (vendor/bin/playwright-install chromium), so run them with testsuite browser -->
        <testsuite name="browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <extensions>
        <!-- Runs each test in a database transaction that is rolled back afterwards -->
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
    </extensions>
    <php>
        <env name="APP_ENV" value="test"/>
        <env name="SHELL_VERBOSITY" value="-1"/>
    </php>
    <source>
        <include>
            <directory suffix=".php">src/</directory>
        </include>
    </source>
</phpunit>
