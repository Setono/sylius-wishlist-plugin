{# @var wishlist \Setono\SyliusWishlistPlugin\Model\WishlistInterface #}
{% set item = wishlist.items.first %}

<div class="card h-100">
    {% if item %}
        {# symfony lsp:check doesn't know anonymous Twig components or the translations in Sylius' Resources/translations/*.yml #}
        {# @symfony-lsp-ignore twig_component.not_found (anonymous component of Sylius' shop) #}
        {{ component('sylius_shop:main_image', {
            product: item.variant and item.variant.hasImages ? item.variant : item.product,
            class: 'card-img-top'
        }) }}
    {% endif %}
    <div class="card-body">
        <a class="card-title h5 stretched-link text-decoration-none" href="{{ path('setono_sylius_wishlist_shop_wishlist_show', { 'uuid': wishlist.uuid }) }}">
            {{ wishlist.name }}
        </a>
    </div>
    <div class="card-footer text-body-secondary d-flex align-items-center gap-2">
        {{ ux_icon('tabler:gift') }}
        {{ wishlist.items.count }} {{ 'sylius.ui.items'|trans }}{# @symfony-lsp-ignore translation.not_found (Sylius' translation) #}
    </div>
</div>
