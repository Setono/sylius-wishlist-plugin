{# @var item \Setono\SyliusWishlistPlugin\Model\WishlistItemInterface #}
{% import "@SyliusShop/shared/macro/money.html.twig" as money %}

{# A product-level item (no variant chosen yet) shows the price of the product's default variant #}
{% set variant = item.variant ?: item.product|sylius_resolve_variant %}
{% set channelPricing = variant is not null ? variant.getChannelPricingForChannel(sylius.channel) : null %}

{% if channelPricing is not null and channelPricing.price is not null %}
    {% set hasDiscount = variant|sylius_has_discount({'channel': sylius.channel}) %}

    {% if hasDiscount %}
        <span class="text-body-secondary text-decoration-line-through">
            {{ money.calculateOriginalPrice(variant) }}
        </span>
    {% endif %}

    <span>
        {{ money.calculatePrice(variant) }}
    </span>
{% elseif variant is not null %}
    {# Sylius can't calculate a price without one in this channel (it throws), e.g. for a product that is no longer sold here #}
    <span class="text-body-secondary">{{ 'sylius.ui.unavailable'|trans }}</span>
{% endif %}
