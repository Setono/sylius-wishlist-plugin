<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Setono\SyliusWishlistPlugin\Model\GuestWishlist">
        <field name="clientId" type="string" nullable="true"/>

        <many-to-one field="mergedInto" target-entity="Setono\SyliusWishlistPlugin\Model\UserWishlistInterface">
            <join-column name="merged_into_id" referenced-column-name="id" nullable="true" on-delete="CASCADE"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
